      "Bash(npx.cmd hyperframes feedback *)",
      "Bash(npx.cmd hyperframes events *)",
      "Bash(npx.cmd hyperframes usage *)",
      "Bash(npx.cmd hyperframes lambda *)",
      "Bash(npx.cmd hyperframes cloudrun *)",
      "Bash(npx.cmd hyperframes auth *)",
      "PowerShell(npx hyperframes publish *)",
      "PowerShell(npx hyperframes cloud *)",
      "PowerShell(npx hyperframes feedback *)",
      "PowerShell(npx hyperframes events *)",
      "PowerShell(npx hyperframes usage *)",
      "PowerShell(npx hyperframes lambda *)",
      "PowerShell(npx hyperframes cloudrun *)",
      "PowerShell(npx hyperframes auth *)",
