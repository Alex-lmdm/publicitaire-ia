{
  "permissions": {
    "allow": [
      "Bash(python3 tools/studio_motion.py *)",
      "Bash(python tools/studio_motion.py *)",
      "Bash(python3 ../../../tools/studio_motion.py *)",
      "Bash(python ../../../tools/studio_motion.py *)",
      "Bash(npx hyperframes check *)",
      "Bash(npx hyperframes lint *)",
      "Bash(npx hyperframes snapshot *)",
      "Bash(npx hyperframes render *)",
      "Bash(npx.cmd hyperframes check *)",
      "Bash(npx.cmd hyperframes lint *)",
