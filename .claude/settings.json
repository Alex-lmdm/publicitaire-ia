      "PowerShell(python ../../../tools/studio_motion.py *)",
      "PowerShell(npx.cmd hyperframes check *)",
      "PowerShell(npx.cmd hyperframes lint *)",
      "PowerShell(npx.cmd hyperframes snapshot *)",
      "PowerShell(npx.cmd hyperframes render *)",
      "PowerShell(npm.cmd run check *)",
      "PowerShell(npm.cmd run render *)"
